SENSITIVE_KEYS={"password_hash"}
def _clean(d):
 return {k:v for k,v in d.items() if k not in SENSITIVE_KEYS} if isinstance(d,dict) else d
def _clean_list(items):
 return [_clean(x) for x in items]
def _raw(e): return [dict(x.data) for x in db.session.execute(select(Record).where(Record.entity_type==e).order_by(Record.id)).scalars()]
def all_(e): return _clean_list(_raw(e))
def one(e,i): return db.session.execute(select(Record).where(Record.entity_type==e,Record.entity_id==i)).scalar_one_or_none()
def put(e,d):
 r=one(e,str(d["id"]));
 if r:r.data=d
 else:db.session.add(Record(entity_type=e,entity_id=str(d["id"]),data=d))
 return d

def nxt(prefix,entity):
    entity_map={"EH":"hazards","HAZ":"hazards","PRJ":"projects","SIT":"sites","VST":"site_visits",
                "EVD":"evidence_files","INT":"interventions","ACT":"actions","CON":"contractors",
                "AUD":"audit_logs","NOTIF":"notifications"}
    rows=db.session.execute(
        select(Record.entity_id).where(Record.entity_type==entity_map.get(prefix,entity))
    ).scalars()
    nums=[int(str(x).rsplit("-",1)[-1]) for x in rows if str(x).rsplit("-",1)[-1].isdigit()]
    next_val=max(nums,default=0)+1
    c=db.session.get(Counter,entity)
    if c:
        c.value=next_val
    else:
        db.session.add(Counter(key=entity,value=next_val))
    return f"{prefix}-2026-{next_val:03d}"

