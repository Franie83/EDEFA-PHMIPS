  ensure_quick_access_users(); return
 db.session.query(Record).delete();db.session.query(Setting).delete();db.session.query(Counter).delete(); d=json.loads(SEED.read_text())
 for e in ENTITIES:
  for x in d.get(e,[]):put(e,x)
